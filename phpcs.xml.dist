<?xml version="1.0"?>
<ruleset name="Clearance Price">
	<description>Coding standards for the Clearance Price for Products plugin.</description>

	<file>clearance.php</file>
	<file>uninstall.php</file>
	<file>includes</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>tests/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="5.6"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-Extra">
		<!-- Short array syntax and modern formatting are fine. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- File-per-class naming already follows class-*.php; the main file is the plugin slug. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="clearance-price"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="clearance_price"/>
				<element value="Clearance_Price"/>
				<element value="CLEARANCE_PRICE"/>
			</property>
		</properties>
	</rule>
</ruleset>
